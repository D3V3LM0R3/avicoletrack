# Application
APP_NAME=AvicoleTrack
APP_ENV=development

# Database
DATABASE_URL= postgresql+psycopg://username:password@127.0.0.1:5432/avicoletrack_db

# Frontend
FRONTEND_URL=https://d3v3lm0r3.github.io/avicoletrack
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_INVITATION_BASE_URL=https://d3v3lm0r3.github.io/avicoletrack/register-invitation

# Authentication
JWT_SECRET=YOUR_RANDOM_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email delivery (Gmail works for demos; use an app password, never the account password)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=AvicoleTrack <no-reply@your-verified-domain.com>