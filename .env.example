# Application
APP_NAME=AvicoleTrack
APP_ENV=development

# Database
DATABASE_URL= postgresql+psycopg://username:password@127.0.0.1:5432/avicoletrack_db

# Frontend
FRONTEND_URL=https://avicoletrack.cm
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_INVITATION_BASE_URL=https://avicoletrack.cm/register-invitation

# Authentication
JWT_SECRET=YOUR_RANDOM_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email delivery (required in production for verification and password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=ton-email-brevo
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE
SMTP_FROM_EMAIL=no-reply@avicoletrack.cm
SMTP_USE_TLS=true